{
  "name": "ipduo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Hero ../public/hero.mp4 --codec h264 --crf 18",
    "render:webm": "remotion render Hero ../public/hero.webm --codec vp9 --crf 30",
    "still": "remotion still Hero ../public/hero-poster.jpg --frame 190 --jpeg-quality 90",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/fonts": "4.0.526",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
