{
  "name": "duo",
  "compatibility_date": "2026-09-17",
  // Only the blog runs the Worker first, to answer range requests for its films;
  // every other path is served by the asset layer directly.
  "main": "./packages/web/worker.ts",
  "assets": {
    "directory": "./packages/web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/blog/*"]
  }
}
