                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "frame",
                                      "id": "xys41",
                                      "name": "Duo is a simulator of Apple's iPhone Duo",
                                      "context": "span",
                                      "clip": true,
                                      "width": "fill_container",
                                      "height": 45,
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "HrgMb",
                                          "fill": "#a3a29a",
                                          "textGrowth": "fixed-width",
                                          "width": 682,
                                          "content": "Duo is a simulator of Apple's iPhone Duo that runs as a web page and as a desktop window. It has the phone's two displays, a hinge you can drag, a home screen, and an App Store. You can build apps for it.",
                                          "lineHeight": 1.5,
                                          "fontFamily": "Inter",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "jAReu",
                                  "name": "a",
                                  "context": "a",
                                  "width": "fill_container",
                                  "height": 110.2,
                                  "fill": "#141413",
                                  "cornerRadius": 14,
                                  "stroke": "#f2f1ec1a",
                                  "strokeWidth": 1,
                                  "strokeAlignment": "inner",
                                  "layout": "vertical",
                                  "gap": 3.99,
                                  "padding": [
                                    17,
                                    19
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "kM86m",
                                      "name": "Getting started",
                                      "context": "span",
                                      "fill": "#f2f1ec",
                                      "content": "Getting started",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "frame",
                                      "id": "cMxXS",
                                      "name": "To build entirely in your browser, open ",
                                      "context": "span",
                                      "clip": true,
                                      "width": "fill_container",
                                      "height": 45,
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "ABCc0",
                                          "fill": "#a3a29a",
                                          "textGrowth": "fixed-width",
                                          "width": 682,
                                          "content": "To build entirely in your browser, open Build, connect an OpenRouter key or a browser-accessible OpenAI-compatible endpoint, and describe your app. No local tools are needed. Your provider receives requests directly; Duo does not proxy your key or prompts.",
                                          "lineHeight": 1.5,
                                          "fontFamily": "Inter",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "lDZsu",
                                  "name": "a",
                                  "context": "a",
                                  "width": "fill_container",
                                  "height": 87.7,
                                  "fill": "#141413",
                                  "cornerRadius": 14,
                                  "stroke": "#f2f1ec1a",
                                  "strokeWidth": 1,
                                  "strokeAlignment": "inner",
                                  "layout": "vertical",
                                  "gap": 4,
