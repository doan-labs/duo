                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "zbGXa",
                                      "name": "Manifest",
                                      "context": "span",
                                      "fill": "#f2f1ec",
                                      "content": "Manifest",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "frame",
                                      "id": "O7JIKT",
                                      "name": "One manifest.json per app. You write thi",
                                      "context": "span",
                                      "clip": true,
                                      "width": "fill_container",
                                      "height": 45,
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "b4bdXS",
                                          "fill": "#a3a29a",
                                          "textGrowth": "fixed-width",
                                          "width": 682,
                                          "content": "One manifest.json per app. You write this file and nothing else about a release; build derives the rest into release.json, which is what the shell, the store and the loader read. Both types are exported by the SDK as Manifest and Release.",
                                          "lineHeight": 1.5,
                                          "fontFamily": "Inter",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "N3Mj9B",
                                  "name": "a",
                                  "context": "a",
                                  "width": "fill_container",
                                  "height": "fill_container",
                                  "fill": "#141413",
                                  "cornerRadius": 14,
                                  "stroke": "#f2f1ec1a",
                                  "strokeWidth": 1,
                                  "strokeAlignment": "inner",
                                  "layout": "vertical",
                                  "gap": 3.99,
                                  "padding": [
                                    17,
                                    19
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "GDvc2",
                                      "name": "Lifecycle",
                                      "context": "span",
                                      "fill": "#f2f1ec",
                                      "content": "Lifecycle",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "text",
                                      "id": "rrndJ",
                                      "name": "What happens between the shell creating ",
                                      "context": "span",
                                      "fill": "#a3a29a",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 45,
                                      "content": "What happens between the shell creating a frame and your app's first paint, and how the connection ends.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "S2JU40",
                                  "name": "a",
                                  "context": "a",
                                  "width": "fill_container",
                                  "height": "fill_container",
                                  "fill": "#141413",
                                  "cornerRadius": 14,
                                  "stroke": "#f2f1ec1a",
                                  "strokeWidth": 1,
                                  "strokeAlignment": "inner",
                                  "layout": "vertical",
                                  "gap": 4,
                                  "padding": [
                                    17,
                                    19
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "t0LpiH",
                                      "name": "Displays and the fold",
                                      "context": "span",
                                      "fill": "#f2f1ec",
                                      "content": "Displays and the fold",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "frame",
                                      "id": "QZiIh",
                                      "name": "Duo has a 387 point cover and a 790 poin",
                                      "context": "span",
                                      "clip": true,
                                      "width": "fill_container",
                                      "height": 45,
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "iK7ZZ",
                                          "fill": "#a3a29a",
                                          "textGrowth": "fixed-width",
                                          "width": 682,
                                          "content": "Duo has a 387 point cover and a 790 point inner display, both 850 tall. The inner display can hold one app full width or two side by side. Your app runs on whichever is lit, and while the phone folds the other display already runs a copy, so the handover has no remount and no flash.",
                                          "lineHeight": 1.5,
                                          "fontFamily": "Inter",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "OKh2R",
                                  "name": "a",
                                  "context": "a",
                                  "width": "fill_container",
                                  "height": "fill_container",
                                  "fill": "#141413",
                                  "cornerRadius": 14,
                                  "stroke": "#f2f1ec1a",
                                  "strokeWidth": 1,
                                  "strokeAlignment": "inner",
                                  "layout": "vertical",
                                  "gap": 3.99,
                                  "padding": [
                                    17,
                                    19
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "bDro2",
                                      "name": "Storage",
                                      "context": "span",
                                      "fill": "#f2f1ec",
                                      "content": "Storage",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fUrg8",
                                      "name": "Two key-value spaces, both strings only,",
                                      "context": "span",
                                      "fill": "#a3a29a",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 45,
                                      "content": "Two key-value spaces, both strings only, both asynchronous, both revisioned. The frame has no localStorage; this is the whole persistence story.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "rE90t",
                                  "name": "a",
                                  "context": "a",
                                  "width": "fill_container",
                                  "height": "fill_container",
                                  "fill": "#141413",
                                  "cornerRadius": 14,
                                  "stroke": "#f2f1ec1a",
                                  "strokeWidth": 1,
                                  "strokeAlignment": "inner",
                                  "layout": "vertical",
                                  "gap": 4,
                                  "padding": [
                                    17,
                                    19
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "Osv20",
                                      "name": "Permissions",
                                      "context": "span",
                                      "fill": "#f2f1ec",
                                      "content": "Permissions",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "text",
                                      "id": "TFx6h",
                                      "name": "An app can use exactly what its manifest",
                                      "context": "span",
                                      "fill": "#a3a29a",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 45,
                                      "content": "An app can use exactly what its manifest declares. There is no runtime prompt and no settings screen: the catalog owner reviews the list, the store row shows it, and the shell enforces it.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
