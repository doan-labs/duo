                              "strokeAlignment": "inner",
                              "layout": "none",
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "jP4qG",
                                  "x": 29,
                                  "y": 31,
                                  "name": "02",
                                  "context": "span",
                                  "width": 44,
                                  "height": 233.07,
