                        {
                          "type": "text",
                          "id": "q7cyl6",
                          "name": "size names a step of Dynamic Type, which",
                          "context": "p",
                          "fill": "#f2f1ec",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 112.19,
                          "content": "size names a step of Dynamic Type, which carries size, leading, tracking and weight together. weight emphasises the step on the HIG ladder. caption is the kit's original name for shared.sub and still renders as it did; prefer size=\"footnote\" color=\"secondary\" in new UI.",
                          "lineHeight": 1.65,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
