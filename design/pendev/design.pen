                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "SDK, @doan-labs/duo-sdk. The bridge between your app and the shell: displays, the fold, storage, commands, widgets and links. One client, os, plus useKV for React.",
                                      "lineHeight": 1.65,
