                      "children": [
                        {
                          "type": "frame",
                          "id": "Ay1d0",
                          "name": "1.2.0",
                          "context": "a",
                          "width": 67.23,
                          "cornerRadius": 8,
                          "layout": "vertical",
                          "justifyContent": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "uQbDf",
                              "fill": "#f2f1ec",
                              "content": "1.2.0",
                              "lineHeight": 1.15,
                              "fontFamily": "Inter Tight",
                              "fontSize": 26,
                              "fontWeight": "600",
                              "letterSpacing": -0.52
