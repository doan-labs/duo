                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "tfU78",
                                          "fill": "#a3a29a",
                                          "textGrowth": "fixed-width",
                                          "width": 174,
                                          "content": "Native text input over `fill`, the field in a form or a sheet. Any `type` works, including `date`, `time` and `datetime-local`; `multiline` swaps in a textarea. Supply a visible label or aria-label.",
