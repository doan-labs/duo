                              "lineHeight": 1.15,
                              "fontFamily": "Inter Tight",
                              "fontSize": 26,
                              "fontWeight": "600",
                              "letterSpacing": -0.52
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "ecA8G",
                      "x": 0,
                      "y": 3156.3,
                      "name": "Add harvested screen, stack, title, list",
                      "context": "p",
                      "fill": "#f2f1ec",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container(720)",
                      "height": 140.23,
                      "content": "Add harvested screen, stack, title, list, row, text, button, toggle, symbol, navigation and passive widget-label components; display subscription and reduced-motion CSS animation presets. Existing Nav/Page/Sym/Num and style subpaths remain supported. Apps bundle their selected kit version. This minor release changes no SDK protocol or host compatibility requirement.",
                      "lineHeight": 1.65,
                      "fontFamily": "Inter",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
