                                    17,
                                    19
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "FyUQl",
                                      "name": "Your first app",
                                      "context": "span",
                                      "fill": "#f2f1ec",
                                      "content": "Your first app",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "text",
                                      "id": "UVjC4",
                                      "name": "create writes five files. Here is what e",
                                      "context": "span",
                                      "fill": "#a3a29a",
                                      "content": "create writes five files. Here is what each one does and what to change first.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
