                                  "padding": [
                                    17,
                                    19
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "HzYKX",
                                      "name": "Catalogs",
                                      "context": "span",
                                      "fill": "#f2f1ec",
                                      "content": "Catalogs",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "text",
                                      "id": "eGySt",
                                      "name": "Apps do not ship with Duo. They install ",
                                      "context": "span",
                                      "fill": "#a3a29a",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 45,
                                      "content": "Apps do not ship with Duo. They install from a catalog: a static index.json next to immutable release folders, served with CORS from any origin. You can host one yourself today.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "QhLj6",
                                  "name": "a",
                                  "context": "a",
                                  "width": "fill_container",
                                  "height": "fill_container",
                                  "fill": "#141413",
                                  "cornerRadius": 14,
                                  "stroke": "#f2f1ec1a",
                                  "strokeWidth": 1,
                                  "strokeAlignment": "inner",
                                  "layout": "vertical",
                                  "gap": 4,
                                  "padding": [
                                    17,
                                    19
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "PEKnA",
                                      "name": "Publishing",
                                      "context": "span",
                                      "fill": "#f2f1ec",
                                      "content": "Publishing",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "text",
                                      "id": "lzCfs",
                                      "name": "There are two ways to distribute a Duo a",
                                      "context": "span",
                                      "fill": "#a3a29a",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 45,
                                      "content": "There are two ways to distribute a Duo app: submit it to the curated catalog through a pull request, or host a catalog yourself. Either way there is no account to create.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
