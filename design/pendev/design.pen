                        },
                        {
                          "type": "text",
                          "id": "woBHw",
                          "name": "Commit on a branch, push it to your fork",
                          "context": "p",
                          "fill": "#f2f1ec",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 108.78,
                          "content": "Commit on a branch, push it to your fork, then open the pull request against main with the app-submission template. The template asks for the app id, the version, the folder, the registry entry, any dependency you added and why, the network origins you declared, and a confirmation that you ran the check.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "Bes5R",
