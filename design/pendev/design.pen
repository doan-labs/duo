                                      "fontWeight": "500"
                                    },
                                    {
                                      "type": "frame",
                                      "id": "EujlJ",
                                      "name": "@doan-labs/duo-cli, a small Bun tool. Un",
                                      "context": "span",
                                      "clip": true,
                                      "width": "fill_container",
                                      "height": 45,
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "h03LG",
                                          "fill": "#a3a29a",
                                          "textGrowth": "fixed-width",
                                          "width": 682,
                                          "content": "@doan-labs/duo-cli, a small Bun tool. Until it is published, run it from the repository as bun packages/cli/index.mjs <command>, or through the scripts create writes into your app's package.json.",
                                          "lineHeight": 1.5,
                                          "fontFamily": "Inter",
                                          "fontSize": 15,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    }
                                  ]
                                },
