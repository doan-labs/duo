                                    0
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "XFo1G",
                                      "name": "Design for the cover first",
                                      "context": "h3",
                                      "fill": "#f2f1ec",
                                      "content": "Design for the cover first",
                                      "lineHeight": 1.15,
                                      "fontFamily": "Inter Tight",
                                      "fontSize": 26,
                                      "fontWeight": "600",
                                      "letterSpacing": -0.52
                                    },
                                    {
                                      "type": "frame",
                                      "id": "j5vBSx",
                                      "name": "spacer",
                                      "width": "fill_container",
                                      "height": 12,
                                      "layout": "none"
                                    },
                                    {
                                      "type": "text",
                                      "id": "NEewR",
                                      "name": "The cover display is 387 points wide; th",
                                      "context": "p",
                                      "fill": "#f2f1ec",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 135.98,
                                      "content": "The cover display is 387 points wide; the inner display is 790, a little more than two covers. A layout that reads on the cover has room to breathe unfolded: a list becomes a list beside its detail, a toolbar spreads out, a chart gets its axis labels back. The reverse never works: an inner-first layout squeezed onto the cover loses controls or text.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "frame",
                                      "id": "peHf7",
                                      "name": "spacer",
                                      "width": "fill_container",
                                      "height": 16,
                                      "layout": "none"
                                    },
                                    {
                                      "type": "text",
                                      "id": "jTGXO",
                                      "name": "Lay out in boxes and let width decide. T",
                                      "context": "p",
                                      "fill": "#f2f1ec",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 81.59,
                                      "content": "Lay out in boxes and let width decide. The kit's components collapse themselves at cover width; yours should too. Never hide a feature on the cover: the person may never unfold the phone for it.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "orSG1",
                              "name": "li",
                              "context": "li",
                              "width": "fill_container",
                              "height": 277.07,
                              "fill": "#141413",
                              "cornerRadius": 14,
                              "stroke": "#f2f1ec1a",
