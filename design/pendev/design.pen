                                    0,
                                    0,
                                    16,
                                    0
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "w28lU",
                                      "name": "Your app runs twice",
                                      "context": "h3",
                                      "fill": "#f2f1ec",
                                      "content": "Your app runs twice",
                                      "lineHeight": 1.15,
                                      "fontFamily": "Inter Tight",
                                      "fontSize": 26,
                                      "fontWeight": "600",
                                      "letterSpacing": -0.52
                                    },
                                    {
                                      "type": "frame",
                                      "id": "HFbDY",
                                      "name": "spacer",
                                      "width": "fill_container",
                                      "height": 12,
                                      "layout": "none"
                                    },
                                    {
                                      "type": "text",
                                      "id": "o8cgoU",
                                      "name": "While the phone is in use, the other dis",
                                      "context": "p",
                                      "fill": "#f2f1ec",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 108.78,
                                      "content": "While the phone is in use, the other display holds a running copy of your app so the fold hands over without a remount or a flash. The copy draws everything and starts nothing: no sound, no network request, no timer of its own. State that both copies must agree on lives in shared storage, not in a component.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "frame",
                                      "id": "mKbLD",
                                      "name": "spacer",
                                      "width": "fill_container",
                                      "height": 16,
                                      "layout": "none"
                                    },
                                    {
                                      "type": "text",
                                      "id": "XgCe5",
                                      "name": "Test it: open your app, fold the phone a",
                                      "context": "p",
                                      "fill": "#f2f1ec",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 54.39,
                                      "content": "Test it: open your app, fold the phone all the way, unfold it. The same note, the same scroll position, the same playback, once.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 17,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "frame",
