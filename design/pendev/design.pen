                        },
                        {
                          "type": "text",
                          "id": "bx61A",
                          "name": "Version 1.2.0. Apps bundle the kit they ",
                          "context": "p",
                          "fill": "#f2f1ec",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 163.17,
                          "content": "Version 1.2.0. Apps bundle the kit they compile against, so a new version never changes whether a host can run an installed app. Components accept native attributes, as for the element, animate for the CSS-only presets and xstyle for compiled StyleX extensions, and refuse raw style and className. The showcase runs every component live, and the Developer gallery is an installable app that renders every export at both display widths.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
